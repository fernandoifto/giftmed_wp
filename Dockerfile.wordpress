# Coolify's BuildKit sandbox cannot resolve deb.debian.org, and it rejects
# network: host. This official image already contains PHP 8.5.12 (built
# Nov 5 2026), WordPress 7.1.4 and the required extensions.
FROM wordpress:php8.5-apache@sha256:63f89c89eeba29421a2660ccc87be392e6d72148724d92fa3d0756e9700786b9

COPY uploads.ini /usr/local/etc/php/conf.d/uploads.ini
COPY docker/wordpress/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
